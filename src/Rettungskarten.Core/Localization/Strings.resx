  <data name="Command_Inspect_Description" xml:space="preserve"><value>Developer tools</value></data>
  <data name="Command_InspectXlsx_Description" xml:space="preserve"><value>Shows worksheets/rows of an XLSX file for schema inspection</value></data>
  <data name="Argument_XlsxPath_Description" xml:space="preserve"><value>Path to the XLSX file</value></data>
  <data name="Option_Rows_Description" xml:space="preserve"><value>Maximum number of rows per worksheet</value></data>

