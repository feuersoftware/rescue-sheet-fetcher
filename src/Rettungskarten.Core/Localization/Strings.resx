  <!-- App / global -->
  <data name="App_Description" xml:space="preserve"><value>Rescue-sheet and vehicle-stock tool for fire brigades (VW Group)</value></data>
  <data name="Option_Verbose_Description" xml:space="preserve"><value>Verbose logs</value></data>
  <data name="Option_Lang_Description" xml:space="preserve"><value>Output language (de, en) - defaults to the OS language</value></data>
  <data name="Error_InvalidLanguage" xml:space="preserve"><value>Invalid --lang value '{0}'. Must be 'de' or 'en'.</value></data>

  <!-- fetch rescue-cards -->
  <data name="Command_Fetch_Description" xml:space="preserve"><value>Fetches data from external sources</value></data>
  <data name="Command_RescueCards_Description" xml:space="preserve"><value>Downloads rescue data sheets for VW Group vehicle brands (German only)</value></data>
  <data name="Option_Brand_Description" xml:space="preserve"><value>Brand (vw, audi, skoda, seat, cupra, porsche, all)</value></data>
  <data name="Option_Output_RescueCards_Description" xml:space="preserve"><value>Target directory for rescue data sheets</value></data>
  <data name="Option_DryRun_Description" xml:space="preserve"><value>Discovery and metadata only, no PDF downloads</value></data>
  <data name="Option_SiblingConfig_Description" xml:space="preserve"><value>Path to sibling-models.json (default: bundled file)</value></data>

  <!-- fetch stock -->
  <data name="Command_Stock_Description" xml:space="preserve"><value>Downloads the KBA vehicle stock (FZ12) for a given year</value></data>
  <data name="Option_Year_Description" xml:space="preserve"><value>Reference year (as of January 1st)</value></data>
  <data name="Option_Output_Stock_Description" xml:space="preserve"><value>Target directory for the vehicle stock data</value></data>

  <!-- prioritize -->
  <data name="Command_Prioritize_Description" xml:space="preserve"><value>Assigns rescue cards a bundling priority based on KBA vehicle stock data</value></data>
  <data name="Option_RescueCardsPath_Description" xml:space="preserve"><value>Path to the rescue cards directory</value></data>
  <data name="Option_StockPath_Description" xml:space="preserve"><value>Path to the vehicle stock directory</value></data>
  <data name="Option_StockYear_Description" xml:space="preserve"><value>Stock year (default: latest available)</value></data>
  <data name="Option_Aliases_Description" xml:space="preserve"><value>Path to model-aliases.json (default: bundled file)</value></data>

  <!-- split porsche -->
  <data name="Command_Split_Description" xml:space="preserve"><value>Post-processes already-downloaded rescue cards</value></data>
  <data name="Command_SplitPorsche_Description" xml:space="preserve"><value>Splits Porsche's combined all-models PDF(s) into one file per model</value></data>
  <data name="Split_Porsche_NoCombinedEntriesFound" xml:space="preserve"><value>No downloaded Porsche entries found - run 'fetch rescue-cards --brand porsche' first.</value></data>
  <data name="Split_Porsche_NoModelsDetected" xml:space="preserve"><value>Could not detect any models in '{0}' - the document layout may have changed.</value></data>
  <data name="Split_Porsche_Result" xml:space="preserve"><value>{0} combined document(s) split into {1} per-model rescue card(s).</value></data>
  <data name="Split_Porsche_DocumentFailed" xml:space="preserve"><value>Failed to split '{0}': {1}</value></data>

  <!-- list brands -->
  <data name="Command_List_Description" xml:space="preserve"><value>Lists information</value></data>
  <data name="Command_ListBrands_Description" xml:space="preserve"><value>Lists supported brands and their implementation status</value></data>

