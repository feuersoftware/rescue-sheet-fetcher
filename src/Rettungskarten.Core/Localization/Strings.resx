  <data name="Brand_VW_Source" xml:space="preserve"><value>assets.feature-app.io JSON feed</value></data>
  <data name="Brand_Audi_Source" xml:space="preserve"><value>audi.com static HTML page</value></data>
  <data name="Brand_Skoda_Source" xml:space="preserve"><value>skoda-auto.de model pages</value></data>
  <data name="Brand_Seat_Source" xml:space="preserve"><value>seat.de model pages</value></data>
  <data name="Brand_Cupra_Status" xml:space="preserve"><value>Fully functional (Switzerland source only)</value></data>
  <data name="Brand_Cupra_Source" xml:space="preserve"><value>cupraofficial.ch static HTML page</value></data>
  <data name="Brand_Porsche_Status" xml:space="preserve"><value>Fully functional (2 combined PDFs, not per-model)</value></data>
  <data name="Brand_Porsche_Source" xml:space="preserve"><value>porsche.com official documents page</value></data>
